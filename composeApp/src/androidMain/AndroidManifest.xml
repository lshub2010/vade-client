<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- miuix-blur-android declares minSdk 33 (RuntimeShader). Its whole pipeline is
         API-gated (isRuntimeShaderSupported() = SDK_INT >= TIRAMISU, every RuntimeShader
         use is @RequiresApi(33)), so on Android 12 and below the liquid-glass surfaces
         degrade to plain tint without blur — no crash path. Overriding keeps the app's
         minSdk 24; verified against miuix-shader-android 0.9.4 sources (see RESULT.md). -->
    <uses-sdk tools:overrideLibrary="top.yukonga.miuix.kmp.blur" />

    <application
        android:allowBackup="false"
        android:label="Vade"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- g-shadow-android probe: no intent filter, explicit component only. exported=true
             because adb shell (uid 2000) cannot start non-exported activities on this API
             level — a dev probe on the emulator, never reachable from the launcher. -->
        <activity android:name=".ShadowProbeActivity" android:exported="true" />
    </application>

</manifest>
